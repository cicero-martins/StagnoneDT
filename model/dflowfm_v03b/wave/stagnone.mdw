   Breaking              = true
   BreakAlpha            = 1.0
   BreakGamma            = 0.73
   Triads                = false
   TriadsAlpha           = 0.1
   TriadsBeta            = 2.2
   WaveSetup             = false
   BedFriction           = jonswap
   BedFricCoef           = 0.067
   Diffraction           = false
   DiffracCoef           = 0.2
   DiffracSteps          = 5
   DiffracProp           = true
   WindGrowth            = true
   WhiteCapping          = Komen
   Quadruplets           = true
   Refraction            = true
   FreqShift             = true
   WaveForces            = dissipation 3d

[Numerics]
