[WaveFileInformation]
   FileVersion           = 02.00

[General]
   ProjectName           = stagnone
   ProjectNr             = 01
   Description           = Stagnone — nested SWAN: outer ~400m (full FM domain) + inner ~100m (lagoon)
   OnlyInputVerify       = false
   SimMode               = stationary
   DirConvention         = nautical
   ReferenceDate         = 2025-01-01
   WindSpeed             = 0.00
   WindDir               = 0.00

[TimePoint]
   Time                  = 0.0000000e+000
   WaterLevel            = 0.0000000e+000
   VelocityX             = 0.0000000e+000
   VelocityY             = 0.0000000e+000

[Constants]
   WaterLevelCorrection  = 0.0
   Gravity               = 9.81
   WaterDensity          = 1025.0
   NorthDir              = 90.0
   MinimumDepth          = 0.05

[Processes]
