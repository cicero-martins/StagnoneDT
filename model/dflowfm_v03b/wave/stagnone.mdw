   MaxIter               = 15

[Output]
   TestOutputLevel       = 0
   TraceCalls            = false
   UseHotFile            = true
   WriteCOM              = true
   MapWriteInterval      = 1800
   COMWriteInterval      = 600
   MapWriteNetCDF        = true
