# Credentials — NEVER commit
.env

# Ad-hoc/throwaway scripts (often contain signed URLs / temporary tokens)
scripts/_*

# Local smoke / debug test directories (regenerable from the corresponding production dirs)
model/dflowfm_*_hdftest_*/
model/dflowfm_*_bcfix_test/
model/dflowfm_*_mntest/
model/dflowfm_*_couplintv_test/
model/dflowfm_*_waveonly_test/

# Planet multi-date composite (regenerable via scripts/planet_mosaic_composite.py, ~3.7 GB)
data/processed/planet_composite_*.nc

# Planet 2023 RF pipeline intermediates (regenerable via scripts/build_planet2023_maltese_rf.py)
data/processed/planet2023_rf/composite_aug2023.tif
data/processed/planet2023_rf/lyzenga_dii_aug2023.tif
data/processed/planet2023_rf/pca_dii_aug2023.tif

# Roughness XYZ from Planet RF (regenerable, large)
data/processed/roughness_satellite_planet2023*.xyz

# QGIS project/auxiliary files (georeferencing session artifacts)
data/processed/*.gpkg
data/processed/*.gpkg-shm
data/processed/*.gpkg-wal
data/processed/*.qgz
data/processed/*_modified.tif
data/processed/*_modified.tif.aux.xml
data/processed/*.png.aux.xml
data/processed/*.png.points
data/processed/*.pdf.aux.xml
data/processed/*.pdf.points
reference/papers/*.tif
reference/papers/*.tif.aux.xml
reference/papers/*.pdf.aux.xml
reference/papers/*.pdf.points

# EDITO run logs captured locally during debugging (useful transient artifacts, not repo-worthy)
output/delft3d-run-docker-*.txt

# ERA5/CMEMS local re-download transient logs (regenerable from scripts)
data/raw/era5_*_download*.log
data/raw/cmems_*_download*.log

# ERA5 raw monthly chunks per re-download window (regenerable via scripts/download_era5_*.py)
data/raw/era5_v04*/

# Local smoke / partition logs (regenerable from the corresponding model dirs)
/smoke_*.log
/partition_*.log
/trapani_test.json

# Model outputs (re-generable, large: ~16-23 GB each)
model/*/output/
model/*/DFM_OUTPUT_*/
model/*/DFM_OUTPUT*/
model/*/*.cache
model/*/unstruc.dia
model/*/*.dia

# SWAN hotstart and intermediate files (all regenerated at runtime)
model/*/wave/hot_*.nc
model/*/wave/*.sta
model/*/wave/PRINT
model/*/wave/PRINT-*
model/*/wave/swaninit
model/*/wave/*.log
model/*/wave/*.prt
model/*/wave/BOTNOW
model/*/wave/CURNOW
model/*/wave/WNDNOW
model/*/wave/INPUT
model/*/wave/NEST*
model/*/wave/SWANIN_*
model/*/wave/TMP_*
model/*/wave/swn-diag.*
model/*/wave/wavm-*.dat
model/*/wave/wavm-*.def
model/*/wave/wavm-*.nc

# Station output pulled back from the server for scoring (regenerable; the
# metrics that matter are committed as data/processed/wl_metrics_ensemble.csv)
model/*/*_his.nc

# Restart files (re-generable from model runs)
model/*/*_rst.nc

# Heavy raw data (download on-demand via notebooks)
data/raw/satellite/

# Regenerable regridded model output (~50-100 MB each; rebuild via scripts/regrid_*_for_opendrift.py)
data/processed/v0*_surface_current.nc

# Restart-input directories cloned per re-run (~78 MB each, regenerable from v04 DFM_OUTPUT)
model/*/restart_input/

# Drifters: large compressed archives (Marettimo full record, regenerable)
data/raw/insitu/marettimo_2025_2026.rar
data/raw/insitu/marettimo_2025_2026.zip
data/raw/insitu/april2024april2025/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.ipynb_checkpoints/
.jupyter/

# Virtual envs (if created locally)
venv/
.venv/
env/

# OS
.DS_Store
Thumbs.db
desktop.ini

# VS Code local (preserve shared .vscode/ if present)
.vscode/launch.json
.vscode/settings.local.json

# Claude Code local state
.claude/

# Empty notebook at root (no purpose)
/StagnoneDT.ipynb

# Temporary files
*.tmp
*.bak
*.bak_attrs
*~

# Microsoft Office lock files (created when docs are open)
~$*


# CMEMS raw monthly downloads per re-download window (regenerable)
data/raw/cmems_v04*/

# Per-partition .dia inside diag/ subfolders (auto-generated runtime, large)
model/*/diag/*.dia

# Reference papers: large raw data (regenerable, but not worth the bandwidth to re-download)
reference/papers/

# Large composites removed from git history (regenerable)
data/processed/planet2025_aug_rf/composite_aug2025_elc.tif
outputs/wetwise_stagnone_panel.pptx

# Ciraolo roughness outputs (regenerable via scripts/build_ciraolo_roughness_dynamic.py)
data/processed/roughness_ciraolo/roughness_ciraolo_dynamic.nc
data/processed/roughness_ciraolo/roughness_ciraolo_bias.nc

# Pre-restriction snapshots kept on disk while the new results are validated
*.bak_unrestricted

# LaTeX build artifacts (regenerable from .tex via latexmk)
manuscript/*.aux
manuscript/*.bbl
manuscript/*.blg
manuscript/*.fdb_latexmk
manuscript/*.fls
manuscript/*.log
manuscript/*.out
manuscript/*.spl
manuscript/*.synctex.gz
manuscript/main.pdf

# ---------------------------------------------------------------------------
# Working-tree triage 2026-08-05 (~5.8 GB of regenerable artefacts)
# ---------------------------------------------------------------------------

# Packaged run inputs+outputs shipped for review (contains DFM_OUTPUT_*, ~3.6 GB)
data/processed/d2025-07-13_inputs_for_review/

# Planet Aug-2025 composites (regenerable via scripts/build_planet_rf_v4.py, ~1 GB)
data/processed/planet2025_aug_rf/composite_aug2025.tif
data/processed/planet2025_aug_rf/composite_aug2025_norm.tif

# Trained RF model binaries (22-72 MB each; retrain via scripts/build_planet_rf_v*.py)
data/processed/planet*/rf_model_*.joblib

# SDB rasters (regenerable via scripts/sdb_*.py, ~244 MB)
data/processed/planet_sdb_2023_2025/

# v05 topobathy + mesh heavy intermediates (regenerable via build_topobathy_v05.py /
# build_mesh_v05.py / interp_bathy_to_mesh_v05.py). NOTE: grid_sobreposta_merged_net.nc
# and Stagnone_v05_manual3_net.nc are deliberately NOT ignored - they carry manual
# UI mesh edits that no script reproduces.
data/processed/mesh_v05/bathy_gridded.nc
data/processed/mesh_v05/topobathy_combined.nc
data/processed/mesh_v05/grid_sobreposta_net.nc
data/processed/mesh_v05/Stagnone_v05_net.nc
data/processed/mesh_v05/*.xyz

# QGIS georeferencing artefacts from Maltese 2025 figure digitisation
data/processed/fig5_*_georef*.tif

# Raw downloads feeding the v05 topobathy pipeline (on-demand, ~266 MB)
data/raw/tinitaly_v05/
data/raw/tinitaly_v05_raw/
data/raw/copernicus_dem_v05/
data/raw/gebco_2024/
data/raw/cmems_v05/

# Extended-window forcing for the d10d12 continuation (149 MB of blended wind alone)
model/dflowfm_v04AE_d10d12_extended/

# MPI partition artefacts - METIS output is machine-bound and not portable across hosts
# (see memory partition_files_machine_bound). Legacy tracked partitions predate this rule.
model/*/*_000?.mdu
model/*/*_000?_net.nc
model/*/DFM_interpreted_idomain_*_net.nc

# SWAN diagnostics written into diag/ subfolders
model/*/diag/swn-diag.*

# Pre-edit backups with suffixes the plain *.bak rule misses
*.bak.pre_*
*.bak_pre_*

# WetWise portal demo payloads + Paraview exports (regenerable via
# scripts/build_wetwise_hydrodynamics_demo.py and scripts/export_for_paraview.py)
outputs/wetwise_demo_jul25/animations/
outputs/wetwise_demo_jul25/spatial/
outputs/wetwise_hydtab/
outputs/wetwise_hydtab.zip
outputs/wetwise_stagnone_ppt.zip
outputs/wetwise_tab_v2_test/
outputs/wetwise_tab/demo_hydrodynamics/data/
outputs/wetwise_tab/demo_hydrodynamics/demo_coarse.nc
outputs/wetwise_tab/demo_hydrodynamics/demo_fine.nc
outputs/wetwise_tab/demo_hydrodynamics/demo_data_full.nc
outputs/paraview/v04AE_merged.nc

# Elsevier guide PDF, third-party, regenerable from the journal page
reference/guide_ecss.pdf

# LaTeX build artefacts in docs/
docs/*.aux
docs/*.log
docs/*.out
docs/*.fls
docs/*.fdb_latexmk
docs/*.synctex.gz

