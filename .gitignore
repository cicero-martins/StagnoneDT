# Credentials — NEVER commit
.env

# Model outputs (re-generable, large: ~16-23 GB each)
model/*/output/
model/*/DFM_OUTPUT_*/
model/*/DFM_OUTPUT*/
model/*/*.cache

# SWAN hotstart and intermediate files
model/*/wave/hot_*.nc
model/*/wave/*.sta
model/*/wave/PRINT
model/*/wave/PRINT-*
model/*/wave/swaninit
model/*/wave/*.log
model/*/wave/*.prt

# Restart files (re-generable from model runs)
model/*/*_rst.nc

# Heavy raw data (download on-demand via notebooks)
data/raw/satellite/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.ipynb_checkpoints/
.jupyter/

# Virtual envs (if created locally)
venv/
.venv/
env/

# OS
.DS_Store
Thumbs.db
desktop.ini

# VS Code local (preserve shared .vscode/ if present)
.vscode/launch.json
.vscode/settings.local.json

# Claude Code local state
.claude/

# Empty notebook at root (no purpose)
/StagnoneDT.ipynb

# Temporary files
*.tmp
*.bak
*~

# Microsoft Office lock files (created when docs are open)
~$*

